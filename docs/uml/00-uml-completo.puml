@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Courier New
skinparam defaultFontSize 12
skinparam dpi 180
skinparam roundcorner 3
skinparam ArrowColor #292929
skinparam classBorderColor #292929
skinparam classBackgroundColor #F3F0FC
skinparam classBackgroundColor<<abstracta>> #FFFCEB
skinparam classBackgroundColor<<interfaz>> #F0FAF0
skinparam classBackgroundColor<<LibGDX>> #EAF3FB
hide circle
title GameLluvia — mapa de clases de core
hide members
skinparam linetype ortho
package "Flujo y presentación" {
class GameLluvia
enum "GameLluvia.Estado" as Estado
class VistaJuego
class DibujoEscenario
class DibujoObjetos
class DibujoPersonaje
}
package "Partida y colisiones" {
class Partida
enum "Partida.Fase" as Fase
class PartidaVersus
class Personaje
class Lluvia
abstract class Gota
class GotaBuena
class GotaMala
class ObjetoEspecial
class JefeOvni
class ChorroAgua
}
package "Controles" {
interface ControlMovimiento
class ControlTeclado
class ControlTactil
}
package "Reglas y perfil" {
class ConfiguracionJuego
class PerfilJugador
enum Aspecto
enum Zona
enum Dificultad
enum TipoObjeto
class Nivel
class "Nivel.Builder" as Builder
}
class ApplicationAdapter <<LibGDX>>
ApplicationAdapter <|-- GameLluvia
GameLluvia --> Estado
GameLluvia *-- VistaJuego
GameLluvia --> ConfiguracionJuego
GameLluvia --> Partida : activa
GameLluvia *-- "0..1" PartidaVersus
VistaJuego *-- DibujoPersonaje
VistaJuego ..> DibujoEscenario
VistaJuego ..> DibujoObjetos
VistaJuego ..> Gota
DibujoPersonaje ..> Aspecto
DibujoEscenario ..> Zona
DibujoObjetos ..> TipoObjeto
PartidaVersus *-- "2" Partida
Partida *-- Personaje
Partida *-- Lluvia
Partida *-- "0..1" JefeOvni
Partida --> Fase
Partida --> Nivel
Partida --> Dificultad
Partida ..> Zona
Lluvia *-- "0..*" Gota
Lluvia ..> Zona
Gota <|-- GotaBuena
Gota <|-- GotaMala
Gota <|-- ObjetoEspecial
Gota ..> Personaje
GotaMala --> TipoObjeto
ObjetoEspecial --> TipoObjeto
JefeOvni *-- "0..*" ChorroAgua
JefeOvni ..> Lluvia
Personaje --> ControlMovimiento : estrategia activa
ControlMovimiento <|.. ControlTeclado
ControlMovimiento <|.. ControlTactil
ConfiguracionJuego *-- PerfilJugador
PerfilJugador --> Aspecto
Aspecto --> Dificultad
Zona ..> TipoObjeto
Dificultad ..> Builder
Builder ..> Nivel : construye
enum MovimientoTerreno {
  NORMAL
  HIELO
  ATACAMA
  ESPACIO
  ~ calcular(pedido : float, anterior : float, delta : float) : float
}
Personaje --> MovimientoTerreno : aplica desplazamiento
Partida ..> MovimientoTerreno : selecciona segun zona o fase

enum ArmaBioma {
 AGUA
 PULSO
 LANZA_HIELO
 RAYO_SOLAR
 HIDRO_PLASMA
}
class SubordinadoOvni {
  - ataque : TipoObjeto
  - vida : int
  ~ recibir(chorro : ChorroAgua) : boolean
}
Partida *-- "0..1" SubordinadoOvni : patrulla
SubordinadoOvni --> TipoObjeto : ataque de la zona
Partida --> ChorroAgua : disparos contra patrulla
enum "JefeOvni.Fase" as FaseOvni {
 NORMAL
 FURIOSA
 SUBORDINADOS
}
JefeOvni --> FaseOvni : delega ataque y trayectoria
JefeOvni *-- "0..2" SubordinadoOvni
ChorroAgua --> ArmaBioma : efecto de impacto
Personaje --> ArmaBioma : arma equipada
enum Hidratacion {
 NORMAL
 FATIGADA
 ~ factor(segundos : float) : float
}
Personaje --> Hidratacion : cambia al beber o por sed
@enduml
