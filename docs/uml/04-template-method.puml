@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Courier New
skinparam defaultFontSize 12
skinparam dpi 180
skinparam roundcorner 3
skinparam ArrowColor #292929
skinparam classBorderColor #292929
skinparam classBackgroundColor #F3F0FC
skinparam classBackgroundColor<<abstracta>> #FFFCEB
skinparam classBackgroundColor<<interfaz>> #F0FAF0
skinparam classBackgroundColor<<LibGDX>> #EAF3FB
hide circle
title 04-template-method
class Lluvia {
+ mover(delta : float, personaje : Personaje) : void
}
abstract class Gota {
- area : Rectangle
- terminada : boolean
+ actualizar(delta : float, personaje : Personaje) : void {final}
# {abstract} calcularMovimiento(delta : float) : void
# {abstract} verificarColision(personaje : Personaje) : boolean
# {abstract} aplicarEfecto(personaje : Personaje) : void
# caer(delta : float, factor : float) : void
# toca(personaje : Personaje, margen : float) : boolean
}
class GotaBuena
class GotaMala
class ObjetoEspecial
Lluvia *-- "0..*" Gota
Gota <|-- GotaBuena
Gota <|-- GotaMala
Gota <|-- ObjetoEspecial
note bottom of GotaBuena
Caída normal, área completa, suma agua.
end note
note bottom of GotaMala
Caída x1.15, margen 4, daño o ácido.
end note
note bottom of ObjetoEspecial
Caída normal, margen 2, efecto según tipo.
end note
note bottom of Gota
  actualizar() llama a despuesDeAtrapar()
  tras aplicar el efecto de la gota.
end note
note bottom of GotaBuena
  Agua doble: caída al 90 %, margen 2,
  +20 puntos y dos cargas de agua.
end note
@enduml
