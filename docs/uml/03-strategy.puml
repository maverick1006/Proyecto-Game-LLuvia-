@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Courier New
skinparam defaultFontSize 12
skinparam dpi 180
skinparam roundcorner 3
skinparam ArrowColor #292929
skinparam classBorderColor #292929
skinparam classBackgroundColor #F3F0FC
skinparam classBackgroundColor<<abstracta>> #FFFCEB
skinparam classBackgroundColor<<interfaz>> #F0FAF0
skinparam classBackgroundColor<<LibGDX>> #EAF3FB
hide circle
title 03-strategy
class GameLluvia {
- tactil : boolean
- entrada() : void
- crearControl() : ControlMovimiento
- alternarControlEnPartida() : void
}
class Partida {
+ getPersonaje() : Personaje
+ actualizar(delta : float) : void
}
class Personaje {
- control : ControlMovimiento
+ setControlMovimiento(control : ControlMovimiento) : void
+ setMovimientoTerreno(terreno : MovimientoTerreno) : void
+ actualizar(delta : float, necesitaAgua : boolean) : void
}
interface ControlMovimiento {
+ actualizar(personaje : Personaje, delta : float) : void
}
class ControlTeclado
class ControlTactil
GameLluvia --> Partida
Partida *-- Personaje
GameLluvia ..> Personaje : T o botón / cambia control
Personaje --> ControlMovimiento : delega cada actualización
ControlMovimiento <|.. ControlTeclado
ControlMovimiento <|.. ControlTactil
GameLluvia ..> ControlTeclado : crea
GameLluvia ..> ControlTactil : crea
enum MovimientoTerreno {
  NORMAL
  HIELO
  ATACAMA
  ESPACIO
  ~ calcular(pedido : float, anterior : float, delta : float) : float
}
Personaje --> MovimientoTerreno : aplica desplazamiento
Partida ..> MovimientoTerreno : selecciona segun zona o fase
@enduml
